# Copy to terraform.tfvars and fill in YOUR values.
# NEVER commit terraform.tfvars (gitignored). NEVER put private keys in this repo.

# --- Auth: prefer OCI CLI profile (~/.oci/config profile DEFAULT) ---
region              = "me-jeddah-1"
config_file_profile = "DEFAULT"

# If you must use explicit API keys instead of the config profile, set these
# in terraform.tfvars only (local, not committed). Paths must be local absolute
# or relative paths that exist on YOUR machine — do not commit .pem files.
# tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaXXXXXXXX"
# user_ocid        = "ocid1.user.oc1..aaaaaaaaXXXXXXXX"
# fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
# private_key_path = "C:/Users/YOU/.oci/oci_api_key.pem"

# --- Scope ---
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaaXXXXXXXX"

# --- Naming ---
name_prefix = "w1"

# --- Network security ---
# Prefer YOUR_PUBLIC_IP/32 (whatismyip). 0.0.0.0/0 is lab-only, NOT production.
allowed_ssh_cidr = "0.0.0.0/0" # NOT production — replace with x.x.x.x/32 when possible

# --- Compute ---
# Paste the *public* key line only (contents of id_ed25519.pub / id_rsa.pub).
ssh_public_key = "ssh-ed25519 AAAA... your_email@example.com"

instance_shape          = "VM.Standard.E4.Flex"
instance_ocpus          = 1
instance_memory_in_gbs  = 8

# Reserved public IP: true → assign_public_ip=false + RESERVED IP attach (default).
# false → ephemeral public IP via instance_assign_public_ip.
use_reserved_public_ip    = true
instance_assign_public_ip = true # only used when use_reserved_public_ip = false
# availability_domain_index = 0

# --- Storage ---
block_volume_size_in_gbs = 50

# File Storage: leave false until mount-target quota is available.
enable_file_storage = false
# fss_export_path        = "/export"
# fss_export_source_cidr = "10.0.0.0/16"
