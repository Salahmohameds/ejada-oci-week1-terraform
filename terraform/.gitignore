# Terraform local state, plugins, and secrets — never commit

.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files with real values (keep examples)
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.auto.tfvars.example

# Backend config with real values (keep examples). backend.tf itself is
# committed (it only has literal, non-secret bucket/region/endpoint values).
backend.hcl
!backend.hcl.example

# Never commit OCI Customer Secret Key / S3-compatible credentials
.oci-s3-credentials
*.env
.env
.env.*

# Keys and certs
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
*_api_key*
