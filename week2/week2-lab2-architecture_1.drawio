        </mxCell>

        <mxCell id="intended4" value="PDF secure-access model — INTENDED" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#FBEDEA;strokeColor=#A8391E;dashed=1;fontColor=#A8391E;fontStyle=1;fontSize=11;" vertex="1" parent="1">
